{
  "name": "@neumaennl/xmlbind-ts",
  "version": "2.4.0",
  "description": "JAXB-like XML binding for TypeScript",
  "author": "Martin Neumann <neumaennl@gmx.net>",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/neumaennl/xmlbind-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neumaennl/xmlbind-ts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.scripts.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "lint": "concurrently --group --names eslint,jscpd,fallow,fallow-production,anonymous-types,prettier \"eslint .\" \"jscpd\" \"fallow dead-code --no-cache --fail-on-issues\" \"fallow dead-code --production --no-cache --fail-on-issues\" \"node scripts/check-anonymous-types.ts\" \"prettier --check .\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "node:check": "node scripts/node-version.ts check",
    "node:update": "node scripts/node-version.ts update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.7",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fallow": "^3.42.0",
    "globals": "^17.11.0",
    "jscpd": "^5.4.3",
    "prettier": "3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
